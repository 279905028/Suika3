global {
    fadein: 0.12;
    fadeout: 0.12;
    clickcancel: no;
    escapecancel: yes;
    rightcancel: yes;
    saveslots: 4;
}
BASE {
    id: 32;
    type: noaction;
    x: 0;
    y: 0;
    image-idle: assets/current/ui-cinema/png/config.png;
}
