}
NAV_CONFIG {
    id: 23;
    type: char;
    x: 32;
    y: 400;
    image-idle: assets/current/ui-cinema/png/side-config-idle.png;
    image-hover: assets/current/ui-cinema/png/side-config-hover.png;
    image-press: assets/current/ui-cinema/png/side-config-press.png;
    var: e_action;
    msg: C;
    max: 1;
}
NAV_GALLERY {
    id: 24;
    type: char;
    x: 32;
    y: 480;
    image-idle: assets/current/ui-cinema/png/side-gallery-idle.png;
    image-hover: assets/current/ui-cinema/png/side-gallery-hover.png;
    image-press: assets/current/ui-cinema/png/side-gallery-press.png;
