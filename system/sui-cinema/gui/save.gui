global {
    fadein: 0.12;
    fadeout: 0.12;
    clickcancel: no;
    escapecancel: yes;
    rightcancel: yes;
    saveslots: 4;
}
BASE {
    id: 32;
    type: noaction;
    x: 0;
    y: 0;
    image-idle: assets/current/ui-cinema/png/save.png;
}
NAV_MENU {
    id: 20;
    type: char;
    x: 32;
    y: 160;
    image-idle: assets/current/ui-cinema/png/side-menu-idle.png;
    image-hover: assets/current/ui-cinema/png/side-menu-hover.png;
    image-press: assets/current/ui-cinema/png/side-menu-press.png;
    var: e_action;
    msg: M;
    max: 1;
}
