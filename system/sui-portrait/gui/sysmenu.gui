    x: 24;
    y: 168;
    image-idle: assets/current/ui-portrait/png/action-auto-idle.png;
    image-hover: assets/current/ui-portrait/png/action-auto-hover.png;
    image-press: assets/current/ui-portrait/png/action-auto-press.png;
}
ACTION_SKIP {
    id: 2;
