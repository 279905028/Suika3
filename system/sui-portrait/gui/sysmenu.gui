    image-idle: assets/current/ui-portrait/png/back-idle.png;
    image-hover: assets/current/ui-portrait/png/back-hover.png;
    image-press: assets/current/ui-portrait/png/back-press.png;
}
ACTION_AUTO {
    id: 1;
