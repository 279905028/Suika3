global {
    fadein: 0.12;
    fadeout: 0.12;
    clickcancel: no;
    escapecancel: yes;
    rightcancel: yes;
    saveslots: 4;
}
BASE {
    id: 32;
    type: noaction;
    x: 0;
    y: 0;
    image-idle: assets/current/ui-portrait/png/sysmenu.png;
}
NAV_MENU {
    id: 20;
    type: char;
    x: 8;
    y: 1136;
    image-idle: assets/current/ui-portrait/png/nav-menu-hover.png;
    image-hover: assets/current/ui-portrait/png/nav-menu-hover.png;
    image-press: assets/current/ui-portrait/png/nav-menu-press.png;
    var: e_action;
    msg: M;
    max: 1;
}
NAV_LOAD {
    id: 21;
    type: char;
    x: 150;
    y: 1136;
    image-idle: assets/current/ui-portrait/png/nav-load-idle.png;
    image-hover: assets/current/ui-portrait/png/nav-load-hover.png;
    image-press: assets/current/ui-portrait/png/nav-load-press.png;
    var: e_action;
    msg: L;
    max: 1;
}
