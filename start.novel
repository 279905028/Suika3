# Formal host entry. Content is appended only by tools/runtime/build.cjs.
[config name="game.locale" value="zh-cn"]
[label name="sui_title"]
[e_title]
[gui file="system/sui-u/gui/title.gui"]
[goto name="sui_title"]
[label name="sui_gallery"]
[sui_gallery]
[goto name="sui_title"]
[label name="sui_start"]
[e_new]
[chapter name="共通篇"]
[bg file="system/sui-u/png/reading-backdrop.png" time="0.0"]
[goto name="SC_ENTRY"]
[label name="e_complete"]
[text text="这段故事暂时落下了句点。\n你可以回到标题，或返回之前的选择。"]
[choose name="e_finish" text1="回到标题" value1="title" text2="回到上一选择" value2="rollback"]
[e_finish]
[goto name="e_complete"]
[label name="e_error"]
[text text="运行状态校验未通过。已有存档已保留。\n请回到标题，选择其他存档或重新开始。"]
[goto name="sui_title"]
